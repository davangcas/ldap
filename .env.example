# Nombre DNS del VPS. Es el que va en el certificado del LDAP y el que QA pone en "Host".
# Sin dominio propio sirve sslip.io, que resuelve el nombre a la IP que lleva adentro:
#   ldap.203-0-113-10.sslip.io  ->  203.0.113.10
LDAP_HOST=ldap.203-0-113-10.sslip.io

# Otro nombre que apunta al mismo VPS pero NO figura en el certificado
# (para probar el error "no corresponde al host").
LDAP_ALT_HOST=203-0-113-10.nip.io

# Nombre de la interfaz de administración (LAM). Tiene que resolver al VPS.
LAM_HOST=lam.203-0-113-10.sslip.io

# Correo para Let's Encrypt (certificados HTTPS de la página de info y de LAM).
# Para probar todo en una máquina local sin dominio, poner: internal
CADDY_TLS=qa@smartfense.com

# Contraseñas del directorio.
LDAP_ADMIN_PASSWORD=cambiar-admin
LDAP_CONFIG_PASSWORD=cambiar-config
LDAP_READONLY_PASSWORD=cambiar-readonly

# Contraseña de la configuración de LAM (no la del login de LAM, que es la de admin).
LAM_PASSWORD=cambiar-lam

# Usuario y contraseña de la página de info y de LAM (autenticación básica de Caddy).
# El hash se genera con: docker run --rm caddy:2 caddy hash-password --plaintext 'la-clave'
WEB_USER=qa
# Entre comillas simples: el hash lleva $ y docker compose los interpretaría.
WEB_PASSWORD_HASH='$2a$14$reemplazar.por.el.hash.generado'
