# Nombre DNS del servidor. Va en el certificado del LDAP y es el que QA pone en "Host".
LDAP_HOST=ldap-admin.davangcas.site

# Otro nombre que apunta al mismo servidor pero NO figura en el certificado
# (para probar el error "no corresponde al host").
LDAP_ALT_HOST=ldap-alt.davangcas.site

# Nombre con el que nginx publica LAM.
LAM_HOST=lam.davangcas.site

# Puertos locales a los que apunta nginx.
INFO_PORT=8041
LAM_PORT=8040

# Contraseñas del directorio. La de readonly se muestra en la página de info:
# tiene que ser distinta de la de admin.
LDAP_ADMIN_PASSWORD=cambiar-admin
LDAP_CONFIG_PASSWORD=cambiar-config
LDAP_READONLY_PASSWORD=cambiar-readonly

# Contraseña de la configuración de LAM (no la del login de LAM, que es la de admin).
LAM_PASSWORD=cambiar-lam

# Usuario y contraseña de la página de info y de LAM.
# El hash se genera con: docker run --rm caddy:2 caddy hash-password --plaintext 'la-clave'
# Va entre comillas simples: el hash lleva $ y docker compose los interpretaría.
WEB_USER=qa
WEB_PASSWORD_HASH='$2a$14$reemplazar.por.el.hash.generado'
