# Directory of the local LDAP test server, loaded when the container starts.
#
# ou=personas is the branch the platform synchronizes (Base DN). ou=direccion
# lives outside it on purpose: its people are the managers of others, so the
# sync has to look them up in the directory instead of finding them in the run.
# ou=externos is also outside the Base DN and must never be imported.

dn: ou=personas,dc=smartfense,dc=local
objectClass: organizationalUnit
ou: personas

dn: ou=direccion,dc=smartfense,dc=local
objectClass: organizationalUnit
ou: direccion

dn: ou=externos,dc=smartfense,dc=local
objectClass: organizationalUnit
ou: externos

# Manager outside the Base DN: reached by a directory lookup.
dn: uid=ceo,ou=direccion,dc=smartfense,dc=local
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
objectClass: top
